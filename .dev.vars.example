# Copy to .dev.vars (gitignored) and fill with random values for local dev, e.g.:
#   openssl rand -hex 32
# Production equivalents are set via `wrangler secret put <NAME>` (OP1).
SESSION_SECRET=
EMAIL_PEPPER=
OTP_PEPPER=

# Mailer (BE3, per committed R2). wrangler.jsonc carries production vars
# (MAILER_DRIVER=resend) and vite dev's platformProxy inherits them, so dev
# MUST override back to the console driver — it LOGS the OTP instead of sending
# it (no real mail in dev/tests). To exercise the Resend adapter locally
# instead, set the driver + MAIL_FROM (a Resend-verified sender) plus the key.
MAILER_DRIVER=console
# MAILER_DRIVER=resend
# MAIL_FROM=bc-codes <noreply@send.example.com>
# RESEND_API_KEY=
# BREVO_API_KEY=

